---
/**
 * Hero principal. Título, subtítulo, CTAs y una imagen opcional
 * (optimizada a WebP vía astro:assets). Los CTAs se pasan por props
 * para no duplicar el componente por página.
 */
import type { ImageMetadata } from 'astro';
import Button from '@components/ui/Button.astro';
import OptimizedImage from '@components/ui/OptimizedImage.astro';

interface Cta {
  label: string;
  href: string;
  icon?: string;
}

export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  primaryCta,
  secondaryCta,
  image,
  imageAlt = '',
} = Astro.props;

const hasImage = Boolean(image);
---

<section class="relative overflow-hidden bg-ink-50">
  <div
    class:list={[
      'container-page grid items-center gap-12 py-section',
      hasImage ? 'lg:grid-cols-2' : 'text-center',
    ]}
  >
    <div class:list={[!hasImage && 'mx-auto max-w-3xl']}>
      {
        eyebrow && (
          <span class="mb-4 inline-block rounded-pill bg-brand-100 px-3 py-1 text-sm font-semibold text-brand-700">
            {eyebrow}
          </span>
        )
      }
      <h1 class="text-4xl sm:text-5xl lg:text-6xl">{title}</h1>
      {
        subtitle && (
          <p class="mt-6 text-lg text-ink-600 sm:text-xl">{subtitle}</p>
        )
      }
      {
        (primaryCta || secondaryCta) && (
          <div
            class:list={[
              'mt-8 flex flex-wrap gap-4',
              !hasImage && 'justify-center',
            ]}
          >
            {primaryCta && (
              <Button
                href={primaryCta.href}
                size="lg"
                icon={primaryCta.icon}
                iconRight
              >
                {primaryCta.label}
              </Button>
            )}
            {secondaryCta && (
              <Button
                href={secondaryCta.href}
                variant="outline"
                size="lg"
                icon={secondaryCta.icon}
              >
                {secondaryCta.label}
              </Button>
            )}
          </div>
        )
      }
    </div>

    {
      image && (
        <OptimizedImage
          src={image}
          alt={imageAlt}
          priority
          class="w-full rounded-card shadow-card"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 50vw, 100vw"
        />
      )
    }
  </div>
</section>
