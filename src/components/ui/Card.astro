---
/**
 * Card genérica. Con `href` se vuelve interactiva (toda la tarjeta clicable).
 * Admite icono (Phosphor) o imagen opcional vía slot "media".
 */
import { Icon } from 'astro-icon/components';

export interface Props {
  title?: string;
  description?: string;
  href?: string;
  /** Icono de Phosphor, p. ej. "ph:rocket-launch". */
  icon?: string;
  class?: string;
}

const { title, description, href, icon, class: className = '' } = Astro.props;

const classes = [
  'group relative flex flex-col gap-3 rounded-card border border-ink-200 bg-white p-6 shadow-card transition-transform',
  href ? 'hover:-translate-y-0.5' : '',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<article class={classes}>
  <slot name="media" />

  {
    icon && (
      <span class="inline-flex size-11 items-center justify-center rounded-btn bg-brand-50 text-brand-600">
        <Icon name={icon} class="size-6" />
      </span>
    )
  }

  {
    title && (
      <h3 class="text-lg font-semibold text-ink-900">
        {href ? (
          <a href={href} class="after:absolute after:inset-0">
            {title}
          </a>
        ) : (
          title
        )}
      </h3>
    )
  }

  {description && <p class="text-ink-600">{description}</p>}

  <slot />
</article>
