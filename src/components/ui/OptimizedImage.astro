---
/**
 * Envoltorio sobre astro:assets <Image>.
 * Genera WebP por defecto, con lazy-loading y decoding async.
 * Uso:
 *   import hero from '@assets/images/hero.jpg';
 *   <OptimizedImage src={hero} alt="..." widths={[400, 800, 1200]} />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  /** Marca como prioritaria (LCP): desactiva lazy-loading. */
  priority?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  widths = [400, 800, 1200],
  sizes = '(min-width: 1024px) 50vw, 100vw',
  priority = false,
  class: className = '',
  ...rest
} = Astro.props;
---

<Image
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  format="webp"
  loading={priority ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={priority ? 'high' : 'auto'}
  class={className}
  {...rest}
/>
